__pycache__/
.DS_Store
.vscode*
.claude/*
.codex/*
output/
logs/
*.mp4
*.pth
*.zip

# G0.7 evaluation: ignore large caches and generated videos
eval/g0.7/.cache/
eval/g0.7/*/videos/

# Smoke / validation artifacts from prior gates (not part of G0.7)
g0-smoke/
g0-smoke-mlx/
m3-validation/
m4-full/
m4-smoke/
m5-smoke/

# Re-allow specific G0.7 JSON config/data files (overrides *.json above)
!eval/g0.7/config.json
!eval/g0.7/blind_map.json
!eval/g0.7/*/world_condition.json
!eval/g0.7/*/embeddings/*.json

# venv
venv/

# E1: cached UMT5 teacher contexts are large (regenerable); only commit manifest.
eval/e1/teacher_contexts/*.safetensors
!eval/e1/teacher_contexts/manifest.jsonl
# E1: adapter weights are large (~545MB each, fp32); stored locally on SSD,
# reproducible via scripts/e1_train_adapter.py. Do not commit to GitHub.
eval/e1/adapter_final/*.safetensors
eval/e1/best_adapter.safetensors

# E2: MiniCPM5+Adapter paired video eval.
# Large artifacts (videos, embedding tensors, latents) are regenerable via
# scripts/e1_encode_with_adapter.py and scripts/g07_gen_stage.py.
eval/e2/embeddings/*.safetensors
eval/e2/videos/
eval/e2/blind/videos/
# Re-allow E2 metadata / manifests / encode result JSONs.
!eval/e2/embeddings/*.json
!eval/e2/*.json
!eval/e2/blind/*.json
