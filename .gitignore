__pycache__/
.DS_Store
.vscode*
.claude/*
.codex/*
output/
logs/
*.mp4
*.pth
*.zip

# G0.7 evaluation: ignore large caches and generated videos
eval/g0.7/.cache/
eval/g0.7/*/videos/

# Smoke / validation artifacts from prior gates (not part of G0.7)
g0-smoke/
g0-smoke-mlx/
m3-validation/
m4-full/
m4-smoke/
m5-smoke/

# Re-allow specific G0.7 JSON config/data files (overrides *.json above)
!eval/g0.7/config.json
!eval/g0.7/blind_map.json
!eval/g0.7/*/world_condition.json
!eval/g0.7/*/embeddings/*.json

# venv
venv/

# E1: cached UMT5 teacher contexts are large (regenerable); only commit manifest.
eval/e1/teacher_contexts/*.safetensors
!eval/e1/teacher_contexts/manifest.jsonl
# E1: adapter weights are large (~545MB each, fp32); stored locally on SSD,
# reproducible via scripts/e1_train_adapter.py. Do not commit to GitHub.
eval/e1/adapter_final/*.safetensors
eval/e1/best_adapter.safetensors

# E2: MiniCPM5+Adapter paired video eval.
# Large artifacts (videos, embedding tensors, latents) are regenerable via
# scripts/e1_encode_with_adapter.py and scripts/g07_gen_stage.py.
eval/e2/embeddings/*.safetensors
eval/e2/videos/
eval/e2/blind/videos/
# Re-allow E2 metadata / manifests / encode result JSONs.
!eval/e2/embeddings/*.json
!eval/e2/*.json
!eval/e2/blind/*.json
eval/e2/.cache/
eval/e2/batch_*.log

# E2E profiling + MLX VAE POC (eval/bench_e2e, eval/bench_vae_mlx).
# Commit only small result/config JSONs; ignore large regenerable artifacts.
eval/bench_e2e/.tmp/
eval/bench_vae_mlx/vae_mlx/model.safetensors
eval/bench_vae_mlx/ref_mps_bf16.npy
eval/bench_vae_mlx/*.log
eval/bench_e2e/*.log

# E1.1: corrected downstream-metric re-eval.  Student context tensors are
# large (56 x [64,4096] bf16 per checkpoint, regenerable via
# scripts/e1_1_reeval.py); only commit the JSON results / summary / manifest.
eval/e1.1/student_contexts_epoch5/*.safetensors
eval/e1.1/student_contexts_epoch20/*.safetensors
!eval/e1.1/*.json
!eval/e1.1/*.jsonl

# E2 root-cause diagnosis (step1/step2) and E1.2 training artifacts.
# Large student/latent/frame outputs are regenerable; commit JSON reports only.
eval/e2_diag/**/*.png
eval/e2_diag/**/*.mp4
eval/e1.2/student_contexts/*.safetensors
eval/e1.2/vae_decode/*.png

# E1.2: cached MiniCPM hidden states + trained adapter weights are large (regenerable)
eval/e1.2/cache/*.safetensors
eval/e1.2/adapter_best.safetensors
eval/e1.2/adapter_final/adapter.safetensors
eval/e1.2/embeddings/*.safetensors
eval/e1.2/smoke/work/
eval/e1.2/smoke/*.mp4
eval/e1.2/smoke/*.png
*.log
